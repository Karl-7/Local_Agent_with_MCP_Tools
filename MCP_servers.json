{
  "mcpServers": {
    "search": {
      "command": "uvx",
      "args": ["duckduckgo-mcp-server"],
      "env": { "DDG_SAFE_SEARCH": "STRICT" }
    },
    "memory": {
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-memory"],
      "env": { "MEMORY_FILE_PATH": "${APP_DIR}/memory.jsonl" },
      "tools": ["add_observations", "delete_observations", "search_nodes"]
    },
    "python": {
      "command": "uvx",
      "args": ["mcp-run-python", "stdio"]
    }
  }
}